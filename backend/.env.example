# Cookie strings obtained from browser DevTools
# Application > Cookies > copy all as "key=value; key2=value2"
NEWSPICKS_COOKIE=
NIKKEI_COOKIE=

# Secret used by Golail to read authenticated article JSON.
# Generate with: openssl rand -hex 32
BRIDGE_SECRET=

# Server configuration
PORT=3001
CACHE_TTL_MINUTES=60
CRON_INTERVAL_MINUTES=30

# Self URL (used for feed links in RSS output)
# Set this to your Railway deployment URL
SELF_URL=https://your-app.up.railway.app
